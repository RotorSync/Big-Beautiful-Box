[Unit]
Description=Rotorsync BLE Watchdog
After=rotorsync.service
# Wants=, not Requires=: the watchdog restarts rotorsync itself, and Requires=
# made that restart kill the watchdog mid-command.
Wants=rotorsync.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/rotorsync_watchdog.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
